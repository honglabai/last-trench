[node name="TextPC" type="Label" parent="GuideDialog/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "• [화면 클릭] 조준 모드 진입 | [ESC] 마우스 커서 해제
• [마우스 이동] 전장 시점 및 가늠좌/가늠쇠 조준
• [마우스 좌클릭] 소총 사격 | [마우스 우클릭] 정밀 견착(ADS)
• [R 키] 탄창 재장전 | [E 키] 거점 포탑 설치 및 수리"

[node name="DescMobile" type="Label" parent="GuideDialog/VBox"]
